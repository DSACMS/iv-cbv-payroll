<h3><%= t("activities.summary.education.details") %></h3>
<%= render(ContactInfoReviewTableComponent.new(field_header: t("shared.table_headers.education_information"), value_header: t("shared.table_headers.your_details"), rows: [
  { label: t("activities.summary.education.school_name"), value: activity.school_name },
  { label: t("activities.summary.education.address"), value: activity.formatted_address },
  { label: t("activities.summary.education.contact_name"), value: activity.contact_name },
  { label: t("activities.summary.education.contact_title"), value: activity.contact_title },
  { label: t("activities.summary.education.contact_email"), value: activity.contact_email },
  { label: t("activities.summary.education.contact_phone"), value: number_to_phone(activity.contact_phone_number, area_code: true) }
])) %>

<h3><%= t("activities.summary.education.term_details") %></h3>
<%= render "activities/education/self_attested_term_table", activity: activity %>
