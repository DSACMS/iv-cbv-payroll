<% if activity.fully_self_attested? %>
  <%= render "activities/summary/fully_self_attested_education_table", activity: activity %>
<% elsif activity.partially_self_attested? %>
  <%= render "activities/summary/partially_self_attested_education_table", activity: activity %>
<% else %>
  <%= render "activities/summary/validated_education_table", activity: activity %>
<% end %>

<% if activity.document_uploads.any? %>
  <%= render DocumentUploadsComponent.new(
    documents: activity.document_uploads.map { |a| { filename: a.filename.to_s } },
    heading_level: 3,
    full_width: true
  ) %>
<% end %>
