<% title = t(@activity.document_upload_title_i18n_key, name: @activity.document_upload_object_title) %>
<% content_for :title, title %>
<%# i18n-tasks-use t('activities.document_uploads.new.title', name: 'name') %>
<%# i18n-tasks-use t('activities.document_uploads.new.title_generic') %>
<%# i18n-tasks-use t('activities.document_uploads.new.suggestion_text_html') %>
<%# i18n-tasks-use t('activities.community_service.document_upload_suggestion_text_html') %>
<%# i18n-tasks-use t('activities.education.document_upload_suggestion_text_html') %>
<%# i18n-tasks-use t('activities.job_training.document_upload_suggestion_text_html') %>
<%# i18n-tasks-use t('activities.employment.document_upload_suggestion_text_html') %>

<% content_for :activity_flow_header do %>
  <%= render ActivityFlowHeaderComponent.new(
    title: t(@activity.document_upload_header_title_i18n_key),
    exit_url: activities_flow_root_path,
    back_url: @back_url,
    track_event_prefix: track_event_prefix
  ) %>
<% end %>

<h1><%= title %></h1>
<p><%= t(".description") %></p>
<ul>
  <% @activity.document_upload_verification_items.each do |item| %>
    <li>
      <strong><%= item[:label] %></strong>
      <% if item[:details].present? %>
        (<%= item[:details] %>)
      <% end %>
    </li>
  <% end %>
</ul>

<% if @activity.document_uploads.any? %>
  <%= render DocumentUploadsComponent.new(
    documents: @activity.document_uploads.map do |attachment|
      {
        filename: attachment.filename.to_s,
        remove_path: remove_document_upload_path(attachment)
      }
    end,
    show_remove_file: true,
    previously_uploaded: true
  ) %>
<% end %>

<%= form_with(builder: UswdsFormBuilder, scope: :activity, model: @activity, url: upload_path, method: :post, data: {
      controller: "document-upload",
      document_upload_presign_url_value: activities_flow_presigned_uploads_path,
      document_upload_max_file_size_value: PresignedUploadService::MAX_UPLOAD_BYTES,
      document_upload_allowed_types_value: "image/*,application/pdf",
      document_upload_heading_template_value: t("activities.document_uploads.heading", document_count: "%{count}"),
      document_upload_remove_label_value: t("activities.document_uploads.remove_file"),
      document_upload_icon_href_value: uswds_sprite_icon_href("file_present"),
      document_upload_error_too_large_value: t(".errors.too_large", limit: number_to_human_size(PresignedUploadService::MAX_UPLOAD_BYTES)),
      document_upload_error_unsupported_type_value: t(".errors.unsupported_type"),
      document_upload_error_upload_failed_value: t(".errors.upload_failed")
    }) do |f| %>
  <% if @activity.document_uploads.any? %>
    <% @activity.document_uploads.each do |attachment| %>
      <%# Keep existing uploads attached when the form is re-submitted with new files. %>
      <%= f.hidden_field :document_uploads, multiple: true, value: attachment.signed_id %>
    <% end %>
  <% end %>

  <div hidden data-document-upload-target="signedIds"></div>

  <%= f.file_field :document_uploads,
      multiple: true,
      label: t(".input_label"),
      label_class: "font-heading-lg text-bold",
      hint: t(".input_hint"),
      accept: "image/*,.pdf",
      data: {
        document_upload_target: "input",
        action: "change->document-upload#select",
        errormessage: t(".errors.unsupported_type")
      } %>

  <div class="usa-error-message" hidden data-document-upload-target="error" role="alert"></div>

  <div class="document-uploads">
    <h2 class="document-uploads__heading" hidden data-document-upload-target="listHeading"></h2>
    <ul class="document-uploads__list" hidden data-document-upload-target="list"></ul>
  </div>

  <%= render(AccordionComponent.new(id: "document-upload-suggestions")) do |accordion| %>
    <% accordion.with_title { t(".suggestion_title") } %>
    <% accordion.with_accordion_item do %>
      <%= t(@activity.document_upload_suggestion_text) %>
    <% end %>
  <% end %>
  <% submit_label = params[:from_review].present? ? t("activities.hub.save") : t(".continue") %>
  <%= f.submit submit_label %>
<% end %>
