<%= render(ContactInfoReviewTableComponent.new(field_header: t("shared.table_headers.employer_information"), value_header: t("shared.table_headers.your_details") rows: [
  { label: t("activities.employment.review.name"), value: employment_activity.employer_name },
  { label: t("activities.employment.review.address"), value: employment_activity.formatted_address },
  { label: t("activities.employment.review.contact_name"), value: employment_activity.contact_name },
  { label: t("activities.employment.review.contact_email"), value: employment_activity.contact_email },
  { label: t("activities.employment.review.contact_phone"), value: employment_activity.contact_phone_number }
])) %>

<h2><%= t("activities.summary.monthly_details") %></h2>
<%= render(TableComponent.new(caption: t("activities.summary.monthly_details"), activity_hours_review: true)) do |table| %>
  <%= table.with_header_cell.with_content(t("activities.summary.employment.month")) %>
  <%= table.with_header_cell.with_content(t("activities.employment.review.gross_income")) %>
  <%= table.with_header_cell(class_names: "text-no-wrap").with_content(t("activities.employment.review.community_engagement_hours")) %>
  <%= table.with_header_cell.with_content(tag.span(t("activities.hub.edit"), class: "usa-sr-only")) %>

  <% employment_activity.employment_activity_months.where(month: employment_activity.months_to_report).order(:month).each_with_index do |activity_month, index| %>
    <% edit_path = edit_activities_flow_income_employment_month_path(employment_id: employment_activity, id: index, from_review: 1, from_edit: params[:from_edit].presence) %>
    <%= table.with_row do |row| %>
      <%= row.with_data_cell(data_label: t("activities.summary.employment.month"), is_header: true) do %>
        <%= I18n.l(activity_month.month, format: :month_year) %>
        <%= link_to t("activities.hub.edit"), edit_path, class: "usa-link mobile-edit-link" %>
      <% end %>
      <%= row.with_data_cell(data_label: t("activities.employment.review.gross_income")).with_content(number_to_currency(activity_month.gross_income)) %>
      <%= row.with_data_cell(data_label: t("activities.employment.review.community_engagement_hours")).with_content(format_decimal_amount(activity_month.hours)) %>
      <%= row.with_data_cell(class_names: "desktop-edit-link") do %>
        <%= link_to t("activities.hub.edit"), edit_path, class: "usa-link" %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
