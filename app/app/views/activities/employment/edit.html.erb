<% unpaid = @flow.unpaid_work_only? %>
<% title = unpaid ? t("activities.employment_info.unpaid_or_in_kind.title") : t("activities.employment_info.edit_title") %>
<% content_for :title, title %>

<% unless @flow.employment_focused? %>
  <% content_for :activity_flow_header do %>
    <%= render ActivityFlowHeaderComponent.new(
      title: unpaid ? t("activities.employment.unpaid_title") : t("activities.employment.title_singular"),
      exit_url: activities_flow_root_path,
      back_url: @back_url,
      track_event_prefix: "Employment"
    ) %>
  <% end %>
<% end %>

<h1>
  <%= title %>
</h1>

<% if @employment_activity.unpaid_or_in_kind? %>
   <% t("activities.employment_info.unpaid_or_in_kind.description").split("\n\n").each do |paragraph| %>
    <p><%= paragraph %></p>
  <% end %>
<% end %>

<%= render "form", employment_activity: @employment_activity %>
