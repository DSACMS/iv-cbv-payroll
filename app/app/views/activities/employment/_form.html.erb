<%= uswds_form_with(model: employment_activity, url: employment_activity.persisted? ? activities_flow_income_employment_path(id: employment_activity.id, from_review: params[:from_review].presence, from_edit: params[:from_edit].presence) : activities_flow_income_employment_index_path(compensation_type: employment_activity.compensation_type)) do |f| %>
  <%= render employment_activity.unpaid_or_in_kind? ? "unpaid_fields" : "paid_fields", f: f %>
  <% submit_label = params[:from_review].present? ? t("activities.hub.save") : t("activities.employment_info.continue") %>
  <%= f.submit submit_label %>
<% end %>
