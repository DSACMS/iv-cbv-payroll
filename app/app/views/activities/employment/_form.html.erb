<% field_label = ->(text) { tag.strong(text) } %>
<% if employment_activity.unpaid_or_in_kind? %>
  <div class="maxw-mobile-lg">
    <%= render AccordionComponent.new(
          id: "unpaid-or-in-kind-work",
          heading_level: 2,
          data_action: "click->common-questions#view",
          data_section_identifier: "unpaid_or_in_kind_work",
          data_page: "employment_information",
          items_as_list: true
        ) do |accordion| %>
      <% accordion.with_title { @flow.unpaid_work_only? ? t("activities.employment_info.unpaid_or_in_kind.accordion.unpaid_title") : t("activities.employment_info.unpaid_or_in_kind.accordion.title") } %>
      <% accordion.with_accordion_item { t("activities.employment_info.unpaid_or_in_kind.accordion.item_1") } %>
      <% accordion.with_accordion_item { t("activities.employment_info.unpaid_or_in_kind.accordion.item_2") } %>
      <% accordion.with_accordion_item { t("activities.employment_info.unpaid_or_in_kind.accordion.item_3") } %>
      <% accordion.with_accordion_item { t("activities.employment_info.unpaid_or_in_kind.accordion.item_4") } %>
    <% end %>
  </div>
<% end %>

<%= uswds_form_with(model: employment_activity, url: employment_activity.persisted? ? activities_flow_income_employment_path(id: employment_activity.id, from_review: params[:from_review].presence, from_edit: params[:from_edit].presence) : activities_flow_income_employment_index_path(compensation_type: employment_activity.compensation_type)) do |f| %>
  <%= render employment_activity.unpaid_or_in_kind? ? "unpaid_fields" : "paid_fields", f: f, field_label: field_label %>
  <% submit_label = params[:from_review].present? ? t("activities.hub.save") : t("activities.employment_info.continue") %>
  <%= f.submit submit_label %>
<% end %>
