<% other = @employment_activity.unpaid_or_in_kind? %>
<% unpaid = @flow.unpaid_work_only? %>
<% unless @flow.employment_focused? %>
  <% content_for :activity_flow_header do %>
    <%= render ActivityFlowHeaderComponent.new(
      title: unpaid ? t("activities.employment.unpaid_title") : t("activities.employment.title_singular"),
      exit_url: activities_flow_root_path,
      back_url: @back_url,
      track_event_prefix: "Employment"
    ) %>
  <% end %>
<% end %>

<% from_review = params[:from_review].present? %>
<% from_edit = params[:from_edit].present? %>
<% month_label = l(@current_month, format: :month) %>
<% input_scope = other ? "activities.employment.hours_input.unpaid_or_in_kind" : "activities.employment.hours_input" %>
<% heading = t("#{input_scope}.heading",
  organization: @employment_activity.employer_name) %>
<% content_for :title, heading %>

<% if @error %>
  <% if !@flow.employment_focused? && !other && @employment_activity.requires_month_selection? && (@activity_month.gross_income || 0).zero? %>
    <% content_for :page_alerts do %>
      <%= render Uswds::Alert.new(type: :info, form_id: "employment_month_form", class: "margin-bottom-4") do %>
        <%= t("activities.employment.hours_input.no_income_html",
              month_selection_url: edit_activities_flow_income_employment_month_selection_path(
                employment_id: @employment_activity, from_edit: params[:from_edit].presence
              )) %>
      <% end %>
    <% end %>
  <% else %>
    <%= render Uswds::Alert.new(
          type: :error,
          heading: t("#{input_scope}.error_heading"),
          form_id: "employment_month_form",
          class: "margin-bottom-4"
        ) do %>
      <% if other && @employment_activity.requires_month_selection? %>
        <%= t("#{input_scope}.error_body_html", month_selection_url: edit_activities_flow_income_employment_month_selection_path(employment_id: @employment_activity, from_edit: params[:from_edit].presence)) %>
      <% elsif unpaid %>
        <%= t("#{input_scope}.field_error") %>
      <% else %>
        <%= t("#{input_scope}.error_body") %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<p class="month-indicator">
  <%= t("activities.employment.hours_input.month_indicator",
        current: @month_index + 1,
        total: @months.length) %>
  <span class="text-normal"><%= month_label %></span>
</p>

<h1 class="margin-top-0 padding-top-2 padding-bottom-1">
  <%= heading %>
</h1>

<%= uswds_form_with(
      model: @activity_month,
      id: "employment_month_form",
      url: activities_flow_income_employment_month_path(
        employment_id: @employment_activity,
        id: @month_index,
        from_review: from_review ? 1 : nil,
        from_edit: from_edit ? 1 : nil
      ),
      method: :patch
    ) do |f| %>
  <% unless other %>
    <%= f.currency_field :gross_income,
          required: true,
          label: t("activities.employment.hours_input.gross_income_label", month: month_label),
          label_class: "text-bold",
          hint: t("activities.employment.hours_input.gross_income_hint") %>
  <% end %>

  <%= f.text_field :hours,
        type: :number,
        step: "any",
        value: decimal_input_value(@activity_month.hours),
        label: t("activities.employment.hours_input.hours_label", month: month_label),
        label_class: "text-bold",
        hint: @flow.unpaid_work_only? ? nil : other ? t("#{input_scope}.hours_hint") : nil %>

  <%= f.submit(from_review ? t("activities.hub.save") : t("activities.employment.hours_input.continue")) %>
<% end %>
