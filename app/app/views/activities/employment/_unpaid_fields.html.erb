<% unpaid = @flow.unpaid_work_only? %>
<h2><%= t("activities.employment_info.unpaid_or_in_kind.work_information_title") %></h2>
<%= f.text_field :employer_name,
      required: true,
      label: field_label.call(t("activities.employment_info.unpaid_or_in_kind.employer_name")),
      hint: t("activities.employment_info.employer_name_hint") %>
<%= render "address_fields", f: f, field_label: field_label %>
<hr class="margin-y-5 border-base border-top-0">
<h2><%= t("activities.employment_info.unpaid_or_in_kind.contact_information_title") %></h2>
<p><%= unpaid ? t("activities.employment_info.unpaid_or_in_kind.contact_information_description_unpaid") : t("activities.employment_info.unpaid_or_in_kind.contact_information_description") %></p>
<%= f.text_field :contact_name, label: field_label.call(t("activities.employment_info.unpaid_or_in_kind.contact_name")) %>
<%= f.email_field :contact_email, label: field_label.call(t("activities.employment_info.unpaid_or_in_kind.contact_email")) %>
<%= f.phone_field :contact_phone_number, label: field_label.call(t("activities.employment_info.unpaid_or_in_kind.contact_phone_number")) %>
