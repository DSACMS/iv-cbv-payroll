<% other = @employment_activity.unpaid_or_in_kind? %>
<% unpaid = @flow.unpaid_work_only? %>
<%# i18n-tasks-use t('activities.employment.review.description') %>
<%# i18n-tasks-use t('activities.employment.review.unpaid_or_in_kind.description') %>
<%# i18n-tasks-use t('activities.employment.review.additional_comments_description') %>
<%# i18n-tasks-use t('activities.employment.review.unpaid_or_in_kind.additional_comments_description') %>
<%# i18n-tasks-use t('activities.employment.review.unpaid_or_in_kind.additional_comments_description_unpaid') %>
<% content_for :title, t("activities.employment.review.title", employer_name: @employment_activity.employer_name) %>

<% unless @flow.employment_focused? %>
  <% content_for :activity_flow_header do %>
    <%= render ActivityFlowHeaderComponent.new(
      title: unpaid ? t("activities.employment.unpaid_title") : t("activities.employment.title_singular"),
      exit_url: activities_flow_root_path,
      back_url: @back_url,
      track_event_prefix: "Employment"
    ) %>
  <% end %>
<% end %>

<h1>
  <%= t("activities.employment.review.title", employer_name: @employment_activity.employer_name) %>
</h1>
<p>
  <% if @flow.employment_focused? %>
    <%= t(".employment_focused.description", employer_name: @employment_activity.employer_name) %>
    <br>
    <br>
    <%= t(".employment_focused.comment_prompt", agency_initials: agency_translation("shared.agency_acronym")) %>
  <% else %>
    <%= t(unpaid ? "activities.employment.review.unpaid_or_in_kind.description" : "activities.employment.review.description",
          employer_name: @employment_activity.employer_name) %>
  <% end %>
</p>

<%= render EmploymentReviewComponent.new(employment_activity: @employment_activity, params: params) %>

<% if @employment_activity.document_uploads.any? %>
  <%= render DocumentUploadsComponent.new(
    documents: @employment_activity.document_uploads.map { |a| { filename: a.filename.to_s } },
    edit_path: new_activities_flow_income_employment_document_upload_path(
      employment_id: @employment_activity,
      from_review: 1,
      from_edit: params[:from_edit].presence
    ),
    full_width: true
  ) %>
<% end %>

<%= form_with model: @employment_activity,
      url: save_review_activities_flow_income_employment_path(id: @employment_activity, from_edit: params[:from_edit].presence),
      method: :patch,
      class: "usa-form usa-form--large" do |form| %>
  <h2><%= t("activities.employment.review.additional_comments_title") %></h2>
  <%= form.label :additional_comments,
        t(unpaid ? "activities.employment.review.unpaid_or_in_kind.additional_comments_description_unpaid" : other ? "activities.employment.review.unpaid_or_in_kind.additional_comments_description" : "activities.employment.review.additional_comments_description",
          agency_name: agency_translation("shared.agency_full_name")),
        class: "usa-label" %>
  <%= form.text_area :additional_comments, class: "usa-textarea", rows: 5 %>

  <% submit_label = params[:from_edit].present? ? t("activities.hub.save") : t("activities.employment.review.save") %>
  <%= form.submit submit_label, class: "usa-button usa-button--primary" %>
<% end %>
