<section>
  <% if section_heading.present? %>
    <h2>
      <%= section_heading %>
    </h2>
  <% end %>

  <h3 class="bg-base-lighter border-1px border-ink font-heading-sm margin-top-3 margin-bottom-0 padding-2">
    <%= title %>
  </h3>

  <%= render(TableComponent.new(
    multi_column: columns.length > 2,
    caption: t("activities.submit.pdf.activity_summary_table_caption", title: title),
    class_names: "activity-report__table border-top-0 font-sans-3xs margin-0 maxw-none"
  )) do |table| %>
    <% community_hours_headers = %w[
      activities.summary.employment.community_engagement_hours
      activities.summary.education.community_engagement_hours
      activities.summary.community_service.community_engagement_hours
      activities.summary.job_training.community_engagement_hours
    ].map { |key| t(key) } %>
    <% columns.each do |column| %>
      <% header_content = community_hours_headers.include?(column) ? content_tag(:span, column, class: "activity-report__no-wrap-header") : column %>
      <%= table.with_header_cell(scope: "col").with_content(header_content) %>
    <% end %>

    <% rows.each do |cells| %>
      <%= table.with_row do |row| %>
        <% cells.each_with_index do |cell, index| %>
          <%= row.with_data_cell(is_header: index.zero?, scope: ("row" if index.zero?)).with_content(cell) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% if documents.any? %>
    <%= render DocumentUploadsComponent.new(
      documents: documents.map { |filename| { filename: filename } },
      heading_level: 4,
      pdf: true
    ) %>
  <% end %>
</section>
