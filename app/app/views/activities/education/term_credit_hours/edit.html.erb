<% content_for :title, t("activities.education.term_credit_hours.heading",
      school_name: @current_term.school_name.titlecase) %>

<% content_for :activity_flow_header do %>
  <%= render ActivityFlowHeaderComponent.new(
    title: t("activities.education.title_singular"),
    exit_url: activities_flow_root_path,
    back_url: @back_url,
    track_event_prefix: "Education"
  ) %>
<% end %>

<p class="month-indicator">
  <%= t("activities.education.term_credit_hours.term_date_range",
        range: @current_term.term_date_display) %>
</p>

<h1 class="margin-top-0 padding-top-2">
  <%= t("activities.education.term_credit_hours.heading",
        school_name: @current_term.school_name.titlecase) %>
</h1>

<p class="font-body-sm margin-bottom-3">
  <%= t("activities.education.term_credit_hours.body") %>
</p>

<% if @current_term.errors.of_kind?(:credit_hours, :no_hours) %>
  <%= render Uswds::Alert.new(
    type: :error,
    heading: t("activities.education.term_credit_hours.error_heading"),
    form_id: "education_term_credit_hours_form",
    class: "margin-bottom-4"
  ) do %>
    <%= t("activities.education.term_credit_hours.error_body_multi_month") %>
  <% end %>
<% end %>

<% collect_enrollment_status = @current_term.enrollment_enrolled? %>
<%= uswds_form_with(model: @current_term,
      id: "education_term_credit_hours_form",
      url: activities_flow_education_term_credit_hour_path(
        education_id: @education_activity,
        id: @term_index,
        from_review: params[:from_review].presence,
        from_edit: params[:from_edit].presence
      ),
      method: :patch,
      data: (collect_enrollment_status ? {
        controller: "education-term",
        education_term_credit_hours_statuses_value: EducationActivity::SELF_ATTESTED_CREDIT_HOURS_STATUSES.to_json
      } : {})) do |f| %>

  <div data-controller="hours-input">
    <% if @show_no_hours_checkbox %>
      <div class="usa-checkbox">
        <%= check_box_tag :no_hours, "1", @current_term.no_hours,
              class: "usa-checkbox__input usa-checkbox__input--tile",
              data: {
                hours_input_target: "checkbox",
                education_term_target: "noHoursCheckbox",
                action: collect_enrollment_status ? "hours-input#toggle education-term#noHoursChanged" : "hours-input#toggle"
              } %>
        <%= label_tag :no_hours,
              t("activities.education.term_credit_hours.no_hours_checkbox",
                school_name: @current_term.school_name.titlecase),
              class: "usa-checkbox__label" %>
      </div>
    <% end %>

    <% if collect_enrollment_status %>
      <%= f.select :supplemental_enrollment_status,
            EducationActivity::SELF_ATTESTED_ENROLLMENT_STATUSES.map { |status| [ t("activities.education.add_your_term.edit.enrollment_status_options.#{status}"), status ] },
            { label: t("activities.education.add_your_term.edit.enrollment_status"), class: "text-bold", include_blank: t("activities.education.add_your_term.edit.select_one") },
            {
              class: ("usa-input--error text-error" if f.has_error?(:supplemental_enrollment_status)),
              aria: { invalid: f.has_error?(:supplemental_enrollment_status) },
              data: { education_term_target: "enrollmentStatus", action: "education-term#enrollmentStatusChanged" }
            } %>
    <% end %>

    <div data-education-term-target="creditHours" <%= "hidden" unless @current_term.supplemental_credit_hours_applicable? %>>
      <%= f.text_field :credit_hours, type: :number, min: 0, step: "any",
            value: decimal_input_value(@current_term.credit_hours),
            label: t("activities.education.add_your_term.edit.credit_hours"),
            hint: t("activities.education.add_your_term.edit.credit_hours_hint"),
            label_class: "text-bold",
            disabled: !@current_term.supplemental_credit_hours_applicable?,
            data: { education_term_target: "creditHoursField", hours_input_target: "hoursField", action: "input->hours-input#input" } %>
    </div>

    <% submit_label = params[:from_review].present? ? t("activities.hub.save") : t("activities.education.term_credit_hours.continue") %>
    <%= f.submit submit_label %>
  </div>
<% end %>
