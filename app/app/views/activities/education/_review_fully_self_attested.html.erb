<div class="display-flex flex-justify activity-review-edit-header">
  <h2 class="margin-y-0"><%= t("activities.education.review.school_info") %></h2>
  <%= link_to t("activities.hub.edit"),
        edit_activities_flow_education_path(id: @education_activity, from_review: 1, from_edit: params[:from_edit].presence),
        class: "usa-link" %>
</div>
<%= render(ContactInfoReviewTableComponent.new(field_header: t("shared.table_headers.education_information"), value_header: t("shared.table_headers.your_details"), rows: [
  { label: t("activities.education.review.school_name"), value: @education_activity.school_name },
  { label: t("activities.education.review.address"), value: @education_activity.formatted_address },
  { label: t("activities.education.review.contact_name"), value: @education_activity.contact_name },
  { label: t("activities.education.review.contact_title"), value: @education_activity.contact_title },
  { label: t("activities.education.review.contact_email"), value: @education_activity.contact_email },
  { label: t("activities.education.review.contact_phone"), value: number_to_phone(@education_activity.contact_phone_number, area_code: true) }
])) %>

<div class="display-flex flex-justify activity-review-edit-header">
  <h2 class="margin-y-0"><%= t("activities.summary.education.term_details") %></h2>
  <%= link_to t("activities.hub.edit"),
        edit_activities_flow_education_add_your_term_path(education_id: @education_activity, from_review: 1, from_edit: params[:from_edit].presence),
        class: "usa-link" %>
</div>

<%= render "activities/education/self_attested_term_table", activity: @education_activity %>

<%= render "activities/education/credit_hours_explainer" %>
