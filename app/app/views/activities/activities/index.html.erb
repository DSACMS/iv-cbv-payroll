<% reporting_window_display = @flow.reporting_window_display %>
<% months_required_display = @flow.months_required_display %>

<% content_for :title, t("activities.hub.title") %>

<div class="activity-hub-columns">
  <div class="activity-hub-columns__progress">
    <h1>
      <%= t("activities.hub.title") %>
    </h1>

    <p class="activity-hub-subheading margin-top-2">
      <strong><%= t("activities.hub.empty_state_reporting_period_label") %></strong>
      <%= reporting_window_display %>
    </p>

    <% if months_required_display %>
      <p class="activity-hub-subheading">
        <strong><%= t("activities.hub.months_required_label") %></strong>
        <%= months_required_display %>
      </p>
    <% end %>

    <% if @flow.any_activities_added? %>
      <%= button_to t("activities.hub.review_and_submit"), next_path, class: "btn btn-primary usa-button width-full margin-top-4", method: :get %>
    <% end %>
  </div>
  <div class="activity-hub-columns__activities">
    <% if show_activity?(:employment) %>
      <% persisted_report = @persisted_report; employment_activities = @employment_activities %>
      <% employment_card_data = combined_employment_card_data(
        reporting_range: @flow.reporting_window_range,
        payroll_accounts: @employment_payroll_accounts,
        persisted_report:,
        employment_activities:
      ) %>
      <% if @flow.unpaid_work_only? %>
        <%= render "activities/activities/activity_section",
              activity_type: "unpaid_work",
              section_title: t("activities.unpaid_work.title"),
              add_path: new_activities_flow_income_employment_path(compensation_type: "unpaid_or_in_kind"),
              empty_message: t("activities.hub.empty.unpaid_work"),
              cards: employment_card_data do %>
          <% employment_card_data.each do |card_data| %>
            <%= render(Uswds::Card.new(heading_text: card_data[:name], heading_level: 3, class: "activity-hub-card")) do |card| %>
              <% card.with_header do %>
                <%= link_to t("activities.hub.edit"), card_data[:edit_path], class: "usa-link" %>
              <% end %>
              <% card.with_body do %>
                <% if card_data[:months].none? %>
                  <div class="margin-top-2">
                    <%= t("activities.hub.cards.no_employment_data") %>
                  </div>
                <% end %>
                <% card_data[:months].each do |month_data| %>
                  <div class="activity-month-details">
                    <div class="activity-month-details__month">
                      <strong><%= I18n.l(month_data[:month], format: :month_year) %></strong>
                    </div>
                    <div class="activity-month-details__data">
                      <p class="margin-y-0"><%= t("activities.hub.cards.hours", count: month_data[:hours]) %></p>
                    </div>
                  </div>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <%= render "activities/activities/activity_section",
              activity_type: "employment",
              section_title: t("activities.employment.title"),
              add_path: activities_flow_income_add_your_work_path,
              empty_message: t("activities.hub.empty.employment"),
              cards: employment_card_data do %>
          <% employment_card_data.each do |card_data| %>
            <%= render(Uswds::Card.new(heading_text: card_data[:name], heading_level: 3, class: "activity-hub-card")) do |card| %>
              <% card.with_header do %>
                <%= link_to t("activities.hub.edit"), card_data[:edit_path], class: "usa-link" %>
              <% end %>
              <% card.with_body do %>
                <% if card_data[:months].none? %>
                  <div class="margin-top-2">
                    <%= t("activities.hub.cards.no_employment_data") %>
                  </div>
                <% end %>
                <% card_data[:months].each do |month_data| %>
                  <div class="activity-month-details">
                    <div class="activity-month-details__month">
                      <strong><%= I18n.l(month_data[:month], format: :month_year) %></strong>
                    </div>
                    <div class="activity-month-details__data">
                      <p class="margin-y-0"><%= t("activities.hub.cards.gross_income", amount: number_to_currency(month_data[:gross_earnings] / 100.0)) %></p>
                      <p class="margin-y-0"><%= t("activities.hub.cards.hours", count: month_data[:hours]) %></p>
                    </div>
                  </div>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if show_activity?(:education) %>
      <% education_card_data = education_cards(@education_activities || [], progress_calculator.reporting_months) %>
      <%= render "activities/activities/activity_section",
            activity_type: "education",
            section_title: t("activities.education.title"),
            add_path: activities_flow_education_add_your_education_path,
            empty_message: t("activities.hub.empty.education"),
            cards: education_card_data do %>
        <% education_card_data.each do |card_data| %>
          <%= render(Uswds::Card.new(heading_text: card_data[:name], heading_level: 3, class: "activity-hub-card")) do |card| %>
            <% card.with_header do %>
              <%= link_to t("activities.hub.edit"), card_data[:edit_path], class: "usa-link" %>
            <% end %>
            <% card.with_body do %>
              <% card_data[:months].each do |month_data| %>
                <div class="activity-month-details">
                  <div class="activity-month-details__month">
                    <strong><%= I18n.l(month_data[:month], format: :month_year) %></strong>
                  </div>
                  <div class="activity-month-details__data">
                    <% if month_data[:enrollment_status].present? %>
                      <p class="margin-y-0"><%= t("activities.hub.cards.enrollment_status", status: month_data[:enrollment_status]) %></p>
                    <% else %>
                      <p class="margin-y-0"><%= t("activities.hub.cards.credit_hours", amount: format_decimal_amount(month_data[:credit_hours])) %></p>
                      <p class="margin-y-0"><%= t("activities.hub.cards.hours", count: format_decimal_amount(month_data[:community_engagement_hours])) %></p>
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if show_activity?(:community_service) %>
      <% community_service_card_data = community_service_cards(@community_service_activities) %>
      <%= render "activities/activities/activity_section",
            activity_type: "community_service",
            section_title: t("activities.community_service.title"),
            add_path: new_activities_flow_community_service_path,
            empty_message: t("activities.hub.empty.community_service"),
            cards: community_service_card_data do %>
        <% community_service_card_data.each do |card_data| %>
          <%= render(Uswds::Card.new(heading_text: card_data[:name], heading_level: 3, class: "activity-hub-card")) do |card| %>
            <% card.with_header do %>
              <%= link_to t("activities.hub.edit"), card_data[:edit_path], class: "usa-link" %>
            <% end %>
            <% card.with_body do %>
              <% card_data[:months].each do |month_data| %>
                <div class="activity-month-details">
                  <div class="activity-month-details__month">
                    <strong><%= I18n.l(month_data[:month], format: :month_year) %></strong>
                  </div>
                  <div class="activity-month-details__data">
                    <p class="margin-y-0"><%= t("activities.hub.cards.hours", count: month_data[:hours]) %></p>
                  </div>
                </div>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if show_activity?(:work_programs) %>
      <% work_programs_card_data = work_program_cards(@work_programs_activities) %>
      <%= render "activities/activities/activity_section",
            activity_type: "work_programs",
            section_title: t("activities.work_programs.title"),
            add_path: new_activities_flow_job_training_path,
            empty_message: t("activities.hub.empty.work_programs"),
            cards: work_programs_card_data do %>
        <% work_programs_card_data.each do |card_data| %>
          <%= render(Uswds::Card.new(heading_text: card_data[:name], heading_level: 3, class: "activity-hub-card")) do |card| %>
            <% card.with_header do %>
              <%= link_to t("activities.hub.edit"), card_data[:edit_path], class: "usa-link" %>
            <% end %>
            <% card.with_body do %>
              <% card_data[:months].each do |month_data| %>
                <div class="activity-month-details">
                  <div class="activity-month-details__month">
                    <strong><%= I18n.l(month_data[:month], format: :month_year) %></strong>
                  </div>
                  <div class="activity-month-details__data">
                    <p class="margin-y-0"><%= t("activities.hub.cards.hours", count: month_data[:hours]) %></p>
                  </div>
                </div>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
