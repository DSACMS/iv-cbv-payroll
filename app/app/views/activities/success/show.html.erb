<% employment_focused = @flow.employment_focused? %>
<% agency_name = agency_translation("shared.agency_full_name") %>

<% title = employment_focused ? t(".employment_focused.title", agency_name: agency_name) : t(".title", agency_name: agency_name) %>

<% next_steps_description = employment_focused ? t(".employment_focused.whats_next.subheading", agency_name: agency_name) : t(".next_steps_description", agency_name: agency_name) %>

<% download_heading = employment_focused ? t(".employment_focused.whats_next.download_your_report.heading") : t(".whats_next_1_title") %>

<% content_for :title, title %>

<div class="grid-col tablet:grid-col-8">
  <div class="grid-row flex-justify-center">
    <svg class="usa-icon usa-icon--size-9 text-success-dark" aria-hidden="true" role="img">
      <use href="<%= asset_path("@uswds/uswds/dist/img/sprite.svg#check_circle") %>"></use>
    </svg>
  </div>
  <h1 class="<%= class_names("margin-top-2": !employment_focused) %>">
    <%= title %>
  </h1>

  <% if employment_focused %>
    <p>
      <%= t(".employment_focused.subheading") %>
    </p>
  <% end %>

  <p>
    <%= t(".confirmation_code_html", confirmation_code: @flow.confirmation_code) %>
  </p>

  <h2>
    <%= t(".whats_next") %>
  </h2>
  <p>
    <%= next_steps_description %>
  </p>

  <%= render(Uswds::IconList.new(class_names: class_names("margin-top-3", "ce-completion-steps": !employment_focused), item_class_names: "margin-bottom-3")) do |icon_list| %>
    <%= icon_list.with_item(icon: "file_download") do %>
      <h3><%= download_heading %></h3>
      <p><%= t(".whats_next_1_li_1") %></p>

      <%= render(LinkWithIconComponent.new(
        t(".download_pdf"),
        url: activities_flow_submit_path(format: :pdf),
        icon: "file_download",
        icon_position: :leading,
        variant: :primary,
        rel: "noopener noreferrer",
        class: "usa-button usa-button--outline margin-top-2",
        target: "_blank"
      )) %>
    <% end %>

    <%= icon_list.with_item(icon: "groups") do %>
      <h3><%= employment_focused ? t(".employment_focused.whats_next.head_of_household.heading") : t(".head_of_household_title") %></h3>
      <p>
        <% if employment_focused %>
          <%= t(".employment_focused.whats_next.head_of_household.subheading") %>
        <% else %>
          <%= t(".head_of_household_description_html", agency_website: current_agency.agency_contact_website) %>
        <% end %>
      </p>
    <% end %>

    <%= icon_list.with_item(icon: "person") do %>
      <h3><%= employment_focused ? t(".employment_focused.whats_next.household_member.heading") : t(".household_member_title") %></h3>
      <p><%= employment_focused ? t(".employment_focused.whats_next.household_member.subheading", agency_name: agency_name) : t(".household_member_description", agency_name: agency_name) %></p>
    <% end %>
  <% end %>

  <div class="divider margin-top-5"></div>

  <div>
    <h2 class="margin-top-5"><%= t(".whats_next_2_title") %></h2>
    <p class="line-height-sans-4"><%= t(".whats_next_2_li_1") %></p>

    <%= render(LinkWithIconComponent.new(
      t(".survey"),
      icon: "launch",
      class: "usa-button usa-button--outline",
      icon_position: :trailing,
      url: feedbacks_path(form: "survey", referer: request.original_url),
      target: "_blank",
      rel: "noopener noreferrer"
    )) %>
  </div>
</div>
