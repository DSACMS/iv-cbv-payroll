<% agency_name = agency_translation("shared.agency_full_name") %>
<% title = t(".header", agency_name: agency_name) %>
<% content_for :title, title %>

<div class="grid-col tablet:grid-col-8">
  <div class="grid-row flex-justify-center">
    <svg class="usa-icon usa-icon--size-9 text-success-dark" aria-hidden="true" role="img">
      <use href="<%= uswds_sprite_icon_href("check_circle") %>"></use>
    </svg>
  </div>

  <h1 class="margin-top-2">
    <%= title %>
  </h1>
  <p>
    <%= t(".confirmation_code_html", confirmation_code: @cbv_flow.confirmation_code) %>
  </p>

  <h2>
    <%= t(".whats_next") %>
  </h2>
  <p>
    <%= t(".next_steps_description", agency_name: agency_name) %>
  </p>

  <%= render(Uswds::IconList.new(class_names: "cbv-success-steps margin-top-3", item_class_names: "margin-bottom-3")) do |icon_list| %>
    <%= icon_list.with_item(icon: "file_download") do %>
      <h3><%= t(".download_title") %></h3>
      <p><%= t(".download_description") %></p>

      <%= render(LinkWithIconComponent.new(
        t(".download"),
        icon: "file_download",
        class: "usa-button usa-button--outline margin-top-2",
        icon_position: :leading,
        variant: :primary,
        url: cbv_flow_submit_path(format: :pdf),
        target: "_blank",
        rel: "noopener noreferrer"
      )) %>
    <% end %>

    <%= icon_list.with_item(icon: "groups") do %>
      <h3><%= t(".head_of_household_title") %></h3>
      <p><%= t(".head_of_household_description_html", agency_website: current_agency.agency_contact_website) %></p>
    <% end %>

    <%= icon_list.with_item(icon: "person") do %>
      <h3><%= t(".household_member_title") %></h3>
      <p><%= t(".household_member_description", agency_name: agency_name) %></p>
    <% end %>
  <% end %>

  <div class="divider margin-top-5"></div>

  <div>
    <h2 class="margin-top-5"><%= t(".whats_next_2_title") %></h2>
    <p class="line-height-sans-4"><%= t(".whats_next_2_li_1_html") %></p>
    <%= render(LinkWithIconComponent.new(
      t(".survey"),
      icon: "launch",
      class: "usa-button usa-button--outline",
      icon_position: :trailing,
      url: feedbacks_path(form: "survey", referer: request.original_url),
      target: "_blank",
      rel: "noopener noreferrer"
    )) %>
  </div>
</div>
