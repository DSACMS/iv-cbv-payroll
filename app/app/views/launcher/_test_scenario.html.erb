<div class="usa-radio">
  <input class="usa-radio__input usa-radio__input--tile" type="radio"
         name="test_scenario" id="test_scenario_<%= scenario_key %>" value="<%= scenario_key %>"
         data-action="advanced-launcher#selectScenario"
         data-reporting-window-months="<%= reporting_window_months %>">
  <label class="usa-radio__label" for="test_scenario_<%= scenario_key %>">
    <strong>
      <%= title %>
    </strong>
    <span class="advanced-launcher__scenario-desc">
      <%= description %>
    </span>
  </label>
</div>
