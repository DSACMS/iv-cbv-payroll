<div class="cbv-footer__partner">
  <div class="cbv-footer__logos" role="group" aria-label="<%= t("shared.footer.partners_label") %>">
    <%= image_tag "emmy-footer-cms-logo.svg",
                  alt: t("shared.footer.cms_logo_alt"),
                  class: "cbv-footer__cms-logo" %>
    <% if current_agency&.logo_path.present? %>
      <%= image_tag current_agency.logo_path,
                    alt: agency_translation("shared.agency_full_name"),
                    class: "cbv-footer__agency-logo" %>
    <% end %>
  </div>
  <p class="cbv-footer__partnership">
    <% if current_agency.present? %>
      <%= t("shared.footer.partnership", agency: agency_translation("shared.agency_full_name")) %>
    <% end %>
  </p>
</div>
