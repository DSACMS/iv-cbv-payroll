<footer class="cbv-footer">
  <div class="cbv-footer__content">
    <div class="cbv-footer__primary">
      <div class="cbv-footer__logo-text">
        <% if activity_flow? %>
          <strong class="cbv-footer__logo-line1"><%= t("shared.pilot_name_hr1_footer_line1") %></strong>
          <span class="cbv-footer__logo-line2"><%= t("shared.pilot_name_hr1") %></span>
        <% else %>
          <strong class="cbv-footer__logo-line1"><%= t("shared.pilot_name") %></strong>
        <% end %>
      </div>
      <%= link_to feedbacks_path(referer: request.original_url),
                  class: "cbv-footer__feedback",
                  target: "_blank" do %>
        <%= image_tag "emmy-footer-feedback-icon.svg", alt: "", class: "cbv-footer__feedback-icon" %>
        <span><%= t("shared.footer.feedback") %></span>
      <% end %>
    </div>

    <% if activity_flow? %>
      <div class="cbv-footer__partner">
        <div class="cbv-footer__logos" role="group" aria-label="<%= t("shared.footer.partners_label") %>">
          <%= image_tag "emmy-footer-cms-logo.svg",
                        alt: t("shared.footer.cms_logo_alt"),
                        class: "cbv-footer__cms-logo" %>
          <% if current_agency&.logo_path.present? %>
            <%= image_tag current_agency.logo_path,
                          alt: agency_translation("shared.agency_full_name"),
                          class: "cbv-footer__agency-logo" %>
          <% end %>
        </div>
        <p class="cbv-footer__partnership">
          <% if current_agency.present? %>
            <%= t("shared.footer.partnership", agency: agency_translation("shared.agency_full_name")) %>
          <% end %>
        </p>
      </div>
    <% end %>
  </div>
</footer>
