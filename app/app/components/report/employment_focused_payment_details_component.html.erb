<% employment_information = t("activities.income.payment_details.show.employment_focused.employment_information") %>
<div class="margin-top-5">
  <h2><%= employment_information %></h2>
  <%= render TableComponent.new(
    caption: employment_information,
    class_names: "maxw-none"
  ) do |table| %>
    <%= table.with_header_cell(scope: "col").with_content(employment_information) %>
    <%= table.with_header_cell(scope: "col").with_content(t("shared.table_headers.your_details")) %>
    <%= table.with_data_point(:employment_start_date, @account_report.employment&.start_date) %>
    <%= table.with_data_point(:employment_end_date, @account_report.employment&.termination_date) %>
    <%= table.with_data_point(:employment_status, @account_report.employment&.status) %>
    <%= table.with_data_point(:pay_frequency, @payroll_account.job_succeeded?("income") ? @account_report.income&.pay_frequency : nil) %>
    <%= table.with_row do |row| %>
      <%= row.with_data_cell(is_header: true, scope: "row").with_content(t("activities.income.payment_details.show.employment_focused.compensation_amount")) %>
      <%= row.with_data_cell.with_content(compensation) %>
    <% end %>
  <% end %>
</div>

<div class="margin-top-5">
  <h2><%= t("activities.income.payment_details.show.employment_focused.monthly_details") %></h2>
  <%= render TableComponent.new(caption: employment_information, class_names: "maxw-none", multi_column: true) do |table| %>
    <%= table.with_header_cell
      .with_content(I18n.t("components.report.monthly_summary_table.month")) %>
    <%= table.with_header_cell
      .with_content(I18n.t("components.report.monthly_summary_table.w2.title_gross_income")) %>
    <%= table.with_header_cell
      .with_content(I18n.t("components.report.monthly_summary_table.w2.title_number_of_paychecks")) %>
    <%= table.with_header_cell
      .with_content(I18n.t("components.report.monthly_summary_table.activity.hours_worked")) %>
    <% @report.flow.reporting_months.each do |month| %>
      <% row_data = month_rows(month) %>
      <%= table.with_row do |row| %>
        <%= row.with_data_cell(data_label: I18n.t("components.report.monthly_summary_table.month"), is_header: true, scope: "row").with_content(row_data[:month]) %>
        <%= row.with_data_cell(data_label: I18n.t("components.report.monthly_summary_table.w2.title_gross_income")).with_content(row_data[:gross_income]) %>
        <%= row.with_data_cell(data_label: I18n.t("components.report.monthly_summary_table.w2.title_number_of_paychecks")).with_content(row_data[:number_of_paychecks]) %>
        <%= row.with_data_cell(data_label: I18n.t("components.report.monthly_summary_table.activity.hours_worked")).with_content(row_data[:hours_worked]) %>
      <% end %>
    <% end %>
  <% end %>
</div>
