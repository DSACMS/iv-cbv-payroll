<div 
  class="<%= alert_classes %>"
  role="alert"
  aria-live="assertive"
  aria-atomic="true"
  tabindex="-1"
  <%= "data-autofocus" if @autofocus %>
>
  <div class="usa-alert__body">
    <% if @heading %>
      <h2 class="usa-alert__heading"><%= @heading %></h2>
    <% end %>
    <div class="usa-alert__text">
      <%= content %>
    </div>
  </div>
</div>
