<div
  class="<%= alert_classes %>"
  role="<%= @form_id.present? ? "group" : @options.fetch(:role, "alert") %>"
  aria-atomic="true"
  <% if controllers.present? %>
    data-controller="<%= controllers %>"
  <% end %>
  <% if @dismiss_key.present? %>
    data-dismissible-alert-key-value="<%= @dismiss_key %>"
  <% end %>
  <% if @form_id.present? %>
    tabindex="-1"
    data-error-summary-form-id-value="<%= @form_id %>"
    <% if @heading %>
      aria-labelledby="<%= "#{@form_id}_error_heading" %>"
    <% end %>
    aria-describedby="<%= "#{@form_id}_error_body" %>"
  <% end %>
>
  <div class="usa-alert__body">
    <% if @heading %>
      <%# Using div here because screen readers will read it twice if it's a heading %>
      <div
        class="usa-alert__heading"
        <% if @form_id.present? %>
          id="<%= "#{@form_id}_error_heading" %>"
        <% end %>
      >
        <%= @heading %>
      </div>
    <% end %>
    <div
      class="usa-alert__text"
      <% if @form_id.present? %>
        id="<%= "#{@form_id}_error_body" %>"
        data-error-summary-target="body"
      <% end %>
    >
      <%= content %>
    </div>
    <% if @dismiss_key.present? %>
      <button type="button" class="usa-button usa-button--unstyled margin-top-1 flex-align-self-start" data-action="dismissible-alert#dismiss">
        <%= t("components.uswds.alert.dismiss") %>
      </button>
    <% end %>
  </div>
</div>
