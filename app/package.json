{
  "name": "app",
  "private": true,
  "type": "module",
  "dependencies": {
    "@csstools/postcss-sass": "^5.1.1",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@rails/actioncable": "^8.1.301",
    "@uswds/uswds": "^3.14.0",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "load-script": "^2.0.0",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.2.0",
    "postcss-minify": "^1.2.0",
    "postcss-nesting": "^14.0.1",
    "postcss-scss": "^4.0.9",
    "sass": "^1.103.1",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --outdir=app/assets/builds --public-path=assets",
    "build:css": "postcss ./app/assets/stylesheets/application.postcss.css -o ./app/assets/builds/application.css",
    "test": "vitest",
    "format": "prettier --write \"app/javascript/**/*.{js,jsx,ts,tsx,json}\" \"spec/javascript/**/*.{js,jsx,ts,tsx,json}\"",
    "format:precommit": "prettier --write"
  },
  "devDependencies": {
    "happy-dom": ">=20.11.6",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "resolutions": {
    "@csstools/postcss-sass/@csstools/sass-import-resolve": "https://github.com/rahearn/sass-import-resolve",
    "nanoid": "^5.0.9"
  },
  "overrides": {
    "serialize-javascript": "^7.0.3"
  }
}
