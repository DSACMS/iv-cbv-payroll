#!/usr/bin/env bash
set -euo pipefail

upgrade_brew_package() {
  package_name=$1
  brew update
  HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK=1 brew upgrade "$package_name"
}

echo "==== node/npm install ============================================="
nodenv install --skip-existing || (
  echo "Failed to install node version. Updating node-build and retrying..."
  upgrade_brew_package "node-build"
  nodenv install --skip-existing
)
npm install

echo "==== ruby/bundle install ====================================="
rbenv install --skip-existing || (
  echo "Failed to install ruby version. Updating ruby-build and retrying..."
  upgrade_brew_package "ruby-build"
  rbenv install --skip-existing
)
bundle install

echo "==== database updates ========================================"
bin/rails db:migrate

echo
echo "Done. Run bin/dev to run the local development server."
